{
  "name": "monorepo-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:backend": "npm run api:dev --workspace=./backend",
    "dev:frontend": "npm run dev --workspace=./frontend",
    "dev": "npx npm-run-all --parallel dev:backend dev:frontend"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.1",
    "pg": "^8.21.0",
    "primevue": "^4.5.5"
  }
}
